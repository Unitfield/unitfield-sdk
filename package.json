{
  "name": "unitfield-sdk",
  "private": true,
  "description": "Unitfield's public JavaScript and TypeScript SDKs.",
  "license": "MIT",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "gen:api": "pnpm --filter @unitfield/sdk gen:api",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "docs:reference": "node scripts/generate-reference.mjs",
    "docs:reference:check": "node scripts/generate-reference.mjs --check",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1"
  }
}
