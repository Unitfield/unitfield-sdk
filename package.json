  "description": "Unitfield's public JavaScript and TypeScript SDKs.",
  "license": "MIT",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "gen:api": "pnpm --filter @unitfield/sdk gen:api",
