# Copy to .env.local (the scaffolder already did) and fill in. Nothing here is read in the browser:
# the server reads it at request time and passes what the browser needs down as props.

# --- Required -----------------------------------------------------------------------------------------------------
# Your site's publishable key: Website > Developers in Unitfield. Use a pk_test_ key while you build.
UNITFIELD_PUBLISHABLE_KEY=
# The Unitfield API. Leave as it is unless Unitfield told you to use another one.
UNITFIELD_API_URL=https://api.unitfield.com

# --- Customer sign-in (optional: without these the Sign in link is hidden) --------------------------------------
# The origin this site is served from. The callback is {UNITFIELD_SITE_URL}/auth/callback and must be listed
# under Redirect URIs for your key.
UNITFIELD_SITE_URL=http://localhost:3000
# The OAuth client id of your key's sign-in client: "Sign-in client ID" under the publishable key in Website > Developers
# (it appears once the key has a redirect URI; the live and the test key have different ones).
UNITFIELD_CLIENT_ID=
# Seals the session cookie. At least 32 random characters, for example: openssl rand -base64 32
UNITFIELD_SESSION_SECRET=
# Only when your sign-in issuer is not https://id.unitfield.app.
# UNITFIELD_ID_URL=

# --- Inquiry form ------------------------------------------------------------------------------------------------
# Nothing to set: the form renders the Cloudflare Turnstile widget Unitfield made for your site, and the API sends its site key
# with the site. Add your site's origin under Allowed origins for your key. Set this only for an API that sends no site key:
# TURNSTILE_SITE_KEY=

# --- Webhooks (optional) ---------------------------------------------------------------------------------------
# The signing secret of the endpoint that points at /api/unitfield/webhook. While rotating, list both, comma separated.
UNITFIELD_WEBHOOK_SECRET=
