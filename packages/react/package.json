{
  "name": "@unitfield/react",
  "version": "0.1.0",
  "description": "React provider, hooks and headless components for sites built on the Unitfield storefront API.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter \"@unitfield/react^...\" run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter \"@unitfield/react^...\" run build",
    "test": "vitest --run --maxWorkers=1",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unitfield/unitfield-sdk.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Unitfield/unitfield-sdk/issues"
  },
  "homepage": "https://github.com/Unitfield/unitfield-sdk/tree/main/packages/react#readme",
  "keywords": [
    "unitfield",
    "property-management",
    "rental",
    "listings",
    "react",
    "hooks",
    "headless"
  ],
  "peerDependencies": {
    "@unitfield/sdk": "^0.1.3",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.101.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@unitfield/sdk": "^0.1.3",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
